{
  "name": "video-download-transcribe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "video-download-transcribe"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "download": "npm --workspace=video-download-transcribe run download",
    "download-model": "npm --workspace=video-download-transcribe run download-model",
    "transcribe": "npm --workspace=video-download-transcribe run transcribe",
    "pipeline": "npm --workspace=video-download-transcribe run pipeline",
    "check": "npm run lint && npm --workspace=video-download-transcribe run check"
  },
  "dependencies": {
    "@video-download-transcribe/skill": "workspace:*",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
